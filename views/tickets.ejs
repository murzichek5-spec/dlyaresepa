<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QMIK | Талоны</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="background app-background">
    <header class="topbar-shell">
      <div class="topbar">
        <a class="brand" href="/">
          <span class="brand-logo">ദ്ദി（• ˕ •マ.ᐟ</span>
          <span class="brand-name">QMIK 2.0</span>
        </a>

        <nav class="nav-links">
          <% if (user.role === 'helper' || user.role === 'admin') { %>
            <a class="nav-link" href="/create">Создать талон</a>
          <% } %>
          <a class="nav-link active" href="/tickets">Талоны</a>
          <form method="post" action="/logout">
            <button class="nav-link logout-button" type="submit">Выйти</button>
          </form>
        </nav>
      </div>
    </header>

    <main class="page">
      <section class="page-heading">
        <div>
          <span class="eyebrow">Общий список талонов.</span>
        </div>
        <div class="heading-actions">
          <div class="user-chip"><span class="status-dot"></span><%= user.username %></div>
        </div>
      </section>

      <% if (error) { %><div class="alert error"><%= error %></div><% } %>
      <% if (success) { %><div class="alert success"><%= success %></div><% } %>

      <form method="get" action="/tickets" class="content-card filters">
        <div class="filter-field search-field">
          <label for="search">Поиск</label>
          <input id="search" type="text" name="search" value="<%= search %>" placeholder="ФИО, телефон или №">
        </div>

        <div class="filter-field">
          <label for="status">Статус</label>
          <select id="status" name="status">
            <option value="all" <%= status === 'all' ? 'selected' : '' %>>Все</option>
            <option value="not_ready" <%= status === 'not_ready' ? 'selected' : '' %>>Не готов</option>
            <option value="ready" <%= status === 'ready' ? 'selected' : '' %>>Готов</option>
            <option value="active" <%= status === 'active' ? 'selected' : '' %>>Переведен на актив</option>
          </select>
        </div>

        <div class="filter-field">
          <label for="date">Дата</label>
          <select id="date" name="date">
            <option value="today" <%= date === 'today' ? 'selected' : '' %>>Сегодня</option>
            <option value="7days" <%= date === '7days' ? 'selected' : '' %>>7 дней</option>
            <option value="all" <%= date === 'all' ? 'selected' : '' %>>Все время</option>
          </select>
        </div>

        <button class="primary-button filter-button" type="submit">Применить</button>
      </form>

      <section class="content-card table-card">
        <div class="table-scroll">
          <table class="tickets-table">
            <thead>
              <tr>
                <th>№ талона</th>
                <th>ФИО</th>
                <th>Телефон</th>
                <th class="center-cell">TG</th>
                <th class="center-cell">МН</th>
                <th class="center-cell">ЯП</th>
                <th>Статус</th>
                <th>Удалить</th>
              </tr>
            </thead>
            <tbody>
              <% if (!tickets.length) { %>
                <tr><td colspan="8" class="empty">Талонов пока нет</td></tr>
              <% } %>

              <% tickets.forEach(ticket => { %>
                <% const canEditServices = user.role === 'admin' || (user.role === 'helper' && ticket.created_by === user.id); %>
                <% const canManage = user.role === 'staff' || user.role === 'admin'; %>
                <% const canEditReady = user.role === 'helper' && ticket.created_by === user.id; %>
                <% const canDelete = canManage || (user.role === 'helper' && ticket.created_by === user.id); %>
                <% const displayStatus = ticket.status === 'active' ? 'active' : (ticket.helper_ready ? 'ready' : 'not_ready'); %>

                <tr data-ticket-id="<%= ticket.id %>" data-ticket-status="<%= displayStatus %>">
                  <td class="ticket-number" data-number-cell>
                    <% if (canManage) { %>
                      <form method="post" action="/tickets/<%= ticket.id %>/number" class="number-form">
                        <input type="number" name="queue_number" min="1" value="<%= ticket.queue_number || '' %>" placeholder="№">
                        <button class="icon-save-button" type="submit" title="Сохранить номер">✓</button>
                      </form>
                    <% } else { %>
                      <span data-live-number><%= ticket.queue_number || '—' %></span>
                    <% } %>
                  </td>

                  <td class="name-cell"><%= ticket.full_name %></td>
                  <td><%= ticket.phone %></td>

                  <% ['telegram', 'my_tax', 'yandex_pro'].forEach(field => { %>
                    <% const dbField = field === 'telegram' ? 'has_telegram' : field === 'my_tax' ? 'has_my_tax' : 'has_yandex_pro'; %>
                    <td class="center-cell">
                      <% if (canEditServices) { %>
                        <label class="table-service-toggle" title="Изменить">
                          <input
                            type="checkbox"
                            data-service-toggle
                            data-field="<%= field %>"
                            <%= ticket[dbField] ? 'checked' : '' %>
                          >
                          <span class="table-check"><%= ticket[dbField] ? '✓' : '—' %></span>
                        </label>
                      <% } else { %>
                        <span data-live-field="<%= field %>" class="feature-mark <%= ticket[dbField] ? 'yes' : 'no' %>"><%= ticket[dbField] ? '✓' : '—' %></span>
                      <% } %>
                    </td>
                  <% }) %>

                  <td data-status-cell>
                    <% if (canEditReady) { %>
                      <% if (ticket.status === 'active') { %>
                        <span data-live-status class="badge active-badge">
                          <span class="badge-dot"></span><span data-status-text>Переведен на актив</span>
                        </span>
                      <% } else { %>
                        <select
                          data-ready-select
                          class="status-select <%= ticket.helper_ready ? 'status-select-ready' : 'status-select-not-ready' %>"
                        >
                          <option value="0" <%= !ticket.helper_ready ? 'selected' : '' %>>Не готов</option>
                          <option value="1" <%= ticket.helper_ready ? 'selected' : '' %>>Готов</option>
                        </select>
                      <% } %>
                    <% } else if (canManage) { %>
                      <div class="staff-status-control">
                        <span data-live-status class="badge <%= displayStatus === 'active' ? 'active-badge' : displayStatus === 'ready' ? 'ready-badge' : 'not-ready-badge' %>">
                          <span class="badge-dot"></span>
                          <span data-status-text><%= displayStatus === 'active' ? 'Переведен на актив' : displayStatus === 'ready' ? 'Готов' : 'Не готов' %></span>
                        </span>
                        <form method="post" action="/tickets/<%= ticket.id %>/status" class="status-action-form" data-status-action-form>
                          <% if (ticket.status === 'active') { %>
                            <button class="restore-status-button" type="submit" name="action" value="restore">Вернуть статус</button>
                          <% } else { %>
                            <button class="activate-status-button" type="submit" name="action" value="active">Перевести на актив</button>
                          <% } %>
                        </form>
                      </div>
                    <% } else { %>
                      <span data-live-status class="badge <%= displayStatus === 'active' ? 'active-badge' : displayStatus === 'ready' ? 'ready-badge' : 'not-ready-badge' %>">
                        <span class="badge-dot"></span><span data-status-text><%= displayStatus === 'active' ? 'Переведен на актив' : displayStatus === 'ready' ? 'Готов' : 'Не готов' %></span>
                      </span>
                    <% } %>
                  </td>

                  <td>
                    <% if (canDelete) { %>
                      <form method="post" action="/tickets/<%= ticket.id %>/delete" class="delete-form" data-delete-form>
                        <button class="delete-button" type="submit">Удалить</button>
                      </form>
                    <% } else { %>
                      <span class="done-mark">—</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <script src="/tickets-live.js"></script>
</body>
</html>

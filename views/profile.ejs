<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QMIK | Мой профиль</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="background app-background">
    <header class="topbar-shell">
      <div class="topbar">
        <a class="brand" href="/activation">
          <span class="brand-logo">ദ്ദി（• ˕ •マ.ᐟ</span>
          <span class="brand-name">QMIK 2.0</span>
        </a>
        <nav class="nav-links">
          <a class="nav-link" href="/activation">Очередь</a>
          <a class="nav-link" href="/processed">Обработанные талоны</a>
          <a class="nav-link active" href="/activation/profile" aria-current="page">Мой профиль</a>
          <form method="post" action="/logout"><button class="nav-link logout-button" type="submit">Выйти</button></form>
        </nav>
      </div>
    </header>

    <main class="page profile-page">
      <section class="page-heading">
        <div>
          <h1>Мой профиль</h1>
        </div>
        <div class="user-chip"><span class="status-dot"></span><%= user.display_name || user.username %></div>
      </section>

      <% if (saved) { %><div class="alert success" role="status">Профиль сохранён. Имя и цвета плашки обновились в очереди.</div><% } %>
      <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>

      <section class="content-card profile-card">
        <h2>Твои данные:</h2>
        <form method="post" action="/activation/profile" class="profile-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="input-group">
            <label for="activation-login">Логин для входа</label>
            <input id="activation-login" type="text" value="<%= user.username %>" disabled>
            <span class="field-help">Логин не меняется — он нужен для авторизации.</span>
          </div>
          <div class="input-group">
            <label for="display-name">Отображаемое имя</label>
            <input id="display-name" type="text" name="display_name" value="<%= user.display_name || user.username %>" required minlength="2" maxlength="40" autocomplete="nickname" placeholder="Например, Александр">
            <span class="field-help">От 2 до 40 символов.</span>
          </div>
          <div class="profile-color-section">
            <div>
              <h3>Оформление плашки</h3>
            </div>
            <div class="profile-color-fields">
              <div class="input-group profile-color-field">
                <label for="owner-bg-color">Цвет плашки</label>
                <div class="profile-color-control">
                  <input type="color" id="owner-bg-color" name="owner_bg_color" value="<%= colors.owner_bg_color %>" aria-label="Выбрать цвет плашки">
                  <output for="owner-bg-color" id="owner-bg-hex"><%= colors.owner_bg_color %></output>
                </div>
              </div>
              <div class="input-group profile-color-field">
                <label for="owner-text-color">Цвет текста</label>
                <div class="profile-color-control">
                  <input type="color" id="owner-text-color" name="owner_text_color" value="<%= colors.owner_text_color %>" aria-label="Выбрать цвет текста">
                  <output for="owner-text-color" id="owner-text-hex"><%= colors.owner_text_color %></output>
                </div>
              </div>
            </div>
            <div class="profile-preview-wrap">
              <span class="field-help">Предпросмотр:</span>
              <span id="owner-preview" class="activation-owner-chip busy" style="--owner-bg: <%= colors.owner_bg_color %>; --owner-text: <%= colors.owner_text_color %>;">У <%= user.display_name || user.username %></span>
            </div>
            <p id="contrast-advice" class="field-help profile-contrast-advice" aria-live="polite" hidden>Текст и фон очень похожи — нейм будет нечитабельным.</p>
          </div>
          <button class="primary-button profile-save" type="submit">Сохранить профиль</button>
        </form>
      </section>

      <section class="profile-stats-section">
        <div class="section-heading-row"><div><h2>Статистика за сегодня</h2></div></div>
        <div class="profile-stats">
          <article class="content-card stat-card">
            <span class="stat-label">Завершено талонов</span>
            <strong class="stat-value"><%= stats.completedToday %></strong>
          </article>
        </div>
      </section>
    </main>
  </div>
  <script src="/profile-colors.js"></script>
</body>
</html>

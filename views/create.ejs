<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ticket System | Создать талон</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="background app-background">
    <header class="topbar-shell">
      <div class="topbar">
        <a class="brand" href="/">
          <span class="brand-logo">ദ്ദി（• ˕ •マ.ᐟ</span>
          <span class="brand-name">Ticket System</span>
        </a>

        <nav class="nav-links">
          <a class="nav-link active" href="/create">Создать талон</a>
          <a class="nav-link" href="/tickets">Талоны</a>
          <form method="post" action="/logout">
            <button class="nav-link logout-button" type="submit">Выйти</button>
          </form>
        </nav>
      </div>
    </header>

    <main class="page page-narrow">
      <section class="page-heading">
        <div>
          <span class="eyebrow">Новый посетитель</span>
          <h1>Создать талон</h1>
          <p>На этом шаге нужны только ФИО и номер телефона.</p>
        </div>
        <div class="user-chip"><span class="status-dot"></span><%= user.username %></div>
      </section>

      <% if (error) { %><div class="alert error"><%= error %></div><% } %>
      <% if (success) { %><div class="alert success"><%= success %></div><% } %>

      <form method="post" action="/create" class="content-card ticket-form">
        <div class="form-section">
          <div class="input-group">
            <label for="full_name">ФИО</label>
            <input id="full_name" type="text" name="full_name" required maxlength="150" placeholder="Иванов Иван Иванович" autocomplete="off">
          </div>

          <div class="input-group">
            <label for="phone">Номер телефона</label>
            <input id="phone" type="text" name="phone" required maxlength="30" placeholder="+7 999 123-45-67" autocomplete="off">
          </div>
        </div>

        <button class="primary-button create-button" type="submit">Создать талон</button>
      </form>

      <section class="helper-section">
        <div class="section-heading-row">
          <div>
            <span class="eyebrow">После создания</span>
            <h2>Сервисы клиентов</h2>
            <p>Отмечай сервисы по мере проверки. Сотрудник увидит изменения сразу.</p>
          </div>
          <div class="live-chip"><span class="live-dot"></span>В реальном времени</div>
        </div>

        <% if (!helperTickets.length) { %>
          <div class="content-card helper-empty">Сегодня ты ещё не создавал талонов.</div>
        <% } %>

        <div class="helper-ticket-list">
          <% helperTickets.forEach(ticket => { %>
            <article class="content-card helper-ticket-card" data-ticket-id="<%= ticket.id %>">
              <div class="helper-ticket-main">
                <div>
                  <div class="helper-ticket-name"><%= ticket.full_name %></div>
                  <div class="helper-ticket-phone"><%= ticket.phone %></div>
                </div>

                <div class="helper-ticket-meta">
                  <% if (ticket.status === 'active') { %>
                    <span class="badge active-badge"><span class="badge-dot"></span>№ <%= ticket.queue_number %> · Переведен на актив</span>
                  <% } else { %>
                    <span class="badge waiting-badge"><span class="badge-dot"></span>Ожидает</span>
                  <% } %>
                </div>
              </div>

              <div class="helper-service-grid">
                <label class="service-option compact-service">
                  <input type="checkbox" data-service-toggle data-field="telegram" <%= ticket.has_telegram ? 'checked' : '' %>>
                  <span class="custom-check"></span>
                  <span>Telegram</span>
                </label>

                <label class="service-option compact-service">
                  <input type="checkbox" data-service-toggle data-field="my_tax" <%= ticket.has_my_tax ? 'checked' : '' %>>
                  <span class="custom-check"></span>
                  <span>Мой налог</span>
                </label>

                <label class="service-option compact-service">
                  <input type="checkbox" data-service-toggle data-field="yandex_pro" <%= ticket.has_yandex_pro ? 'checked' : '' %>>
                  <span class="custom-check"></span>
                  <span>Яндекс Про</span>
                </label>
              </div>

              <div class="save-state" aria-live="polite"></div>
            </article>
          <% }) %>
        </div>
      </section>
    </main>
  </div>

  <script src="/helper.js"></script>
</body>
</html>
